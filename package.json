{
  "name": "reallogixs-elearning",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "prisma generate && next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:demo": "SEED_DEMO=1 prisma db seed",
    "db:admin": "tsx --conditions=react-server --env-file=.env.local scripts/create-admin.ts",
    "db:admin:prod": "tsx --conditions=react-server --env-file=.env.prod scripts/create-admin.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "clsx": "^2.1.1",
    "formik": "^2.4.9",
    "gsap": "^3.15.1",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcrypt": "6.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
