# Copy to .env.local and fill in. Never commit real values.

# Supabase → Connect → ORMs. Transaction pooler, port 6543: used by the running site.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler, port 5432: used only for migrations and seeding.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

# Where emailed links point. Required in production.
SITE_URL="http://localhost:3100"

# Hostinger mailbox. Without these, development emails are saved in the .mail folder instead.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Optional; must be the same mailbox.
MAIL_FROM=""

# Cloudinary → Settings → API Keys. Without these, development files are saved in .uploads instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Told about every new payment that needs checking.
PAYMENT_ALERT_EMAIL="reallogixs@outlook.com"

# Lets each batch of bulk email start the next one (certificates for big classes). Any long random
# string; Vercel also sends it to the daily cron. openssl rand -hex 32
CRON_SECRET="967a3acf58e3e76ae48abd1b1ead34b8348aaa12c4d6d454638e35905ec646b8"
